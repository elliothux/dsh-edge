{
  "name": "@open-compute/dsh-edge",
  "version": "0.12.4",
  "description": "DeepSeek Harness on Cloudflare Workers — CLI installer and embeddable Edge runtime for open-compute hosts",
  "author": "open-compute",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-edge": "scripts/cli.mjs"
  },
  "files": [
    "dist",
    "worker",
    "src",
    "scripts",
    "edge-client",
    "vendor",
    "standalone/scripts",
    "standalone/patches",
    "standalone/package.json",
    "standalone/pnpm-lock.yaml",
    "standalone/pnpm-workspace.yaml",
